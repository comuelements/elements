<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Elements — Conecte-se. Compartilhe. Cresça.</title>

    <meta name="description"
        content="Elements é uma comunidade para empresários se conectarem, trocarem experiências e construírem novas oportunidades.">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
                Roboto, Helvetica, Arial, sans-serif;
            background: #080808;
            color: #ffffff;
            line-height: 1.6;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        /* =========================
           NAVBAR
        ========================= */

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(8, 8, 8, 0.75);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        }

        .navbar {
            max-width: 1150px;
            margin: auto;
            height: 76px;
            padding: 0 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .logo span {
            color: #a3a3a3;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 35px;
            list-style: none;
        }

        .nav-links a {
            color: #b5b5b5;
            font-size: 14px;
            transition: 0.25s;
        }

        .nav-links a:hover {
            color: #ffffff;
        }

        .nav-button {
            padding: 11px 19px;
            border-radius: 9px;
            background: #ffffff;
            color: #080808 !important;
            font-weight: 700;
        }

        .menu-button {
            display: none;
            background: none;
            border: none;
            color: white;
            font-size: 26px;
            cursor: pointer;
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 100vh;
            padding: 150px 25px 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 650px;
            height: 650px;
            background: rgba(255, 255, 255, 0.055);
            filter: blur(130px);
            border-radius: 50%;
            top: 10%;
            left: 50%;
            transform: translateX(-50%);
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            max-width: 900px;
            text-align: center;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 13px;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background: rgba(255, 255, 255, 0.04);
            border-radius: 50px;
            color: #bdbdbd;
            font-size: 12px;
            margin-bottom: 28px;
        }

        .badge-dot {
            width: 7px;
            height: 7px;
            background: #ffffff;
            border-radius: 50%;
        }

        .hero h1 {
            font-size: clamp(48px, 8vw, 88px);
            line-height: 0.98;
            letter-spacing: -5px;
            font-weight: 800;
            margin-bottom: 27px;
        }

        .hero h1 span {
            color: #777777;
        }

        .hero p {
            max-width: 650px;
            margin: auto;
            color: #999999;
            font-size: 18px;
            line-height: 1.7;
        }

        .hero-buttons {
            margin-top: 35px;
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .button {
            padding: 14px 23px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            transition: 0.25s;
            display: inline-block;
        }

        .button-primary {
            background: #ffffff;
            color: #080808;
        }

        .button-primary:hover {
            transform: translateY(-2px);
            background: #e9e9e9;
        }

        .button-secondary {
            border: 1px solid #292929;
            color: #dddddd;
            background: #101010;
        }

        .button-secondary:hover {
            background: #181818;
        }

        /* =========================
           STATS
        ========================= */

        .stats {
            max-width: 1000px;
            margin: -25px auto 100px;
            padding: 0 25px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .stat {
            padding: 28px;
            background: #0d0d0d;
            border: 1px solid #1c1c1c;
            border-radius: 14px;
            text-align: center;
        }

        .stat h3 {
            font-size: 30px;
            margin-bottom: 3px;
        }

        .stat p {
            color: #777777;
            font-size: 13px;
        }

        /* =========================
           SECTIONS
        ========================= */

        section {
            scroll-margin-top: 90px;
        }

        .section {
            max-width: 1100px;
            margin: auto;
            padding: 110px 25px;
        }

        .section-header {
            max-width: 650px;
            margin-bottom: 50px;
        }

        .section-label {
            color: #777777;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
            margin-bottom: 13px;
        }

        .section h2 {
            font-size: clamp(34px, 5vw, 55px);
            line-height: 1.05;
            letter-spacing: -2.5px;
            margin-bottom: 18px;
        }

        .section-header p {
            color: #858585;
            font-size: 16px;
        }

        /* =========================
           CARDS
        ========================= */

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .card {
            padding: 30px;
            background: linear-gradient(
                145deg,
                #111111,
                #0b0b0b
            );
            border: 1px solid #202020;
            border-radius: 16px;
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-5px);
            border-color: #353535;
        }

        .card-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 11px;
            background: #191919;
            border: 1px solid #292929;
            margin-bottom: 25px;
            font-size: 18px;
        }

        .card h3 {
            font-size: 19px;
            margin-bottom: 10px;
        }

        .card p {
            color: #777777;
            font-size: 14px;
        }

        /* =========================
           SOBRE
        ========================= */

        .about {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 70px;
            align-items: center;
        }

        .about-text p {
            color: #8b8b8b;
            margin-bottom: 17px;
            font-size: 16px;
        }

        .about-box {
            min-height: 370px;
            border-radius: 18px;
            border: 1px solid #222222;
            background:
                radial-gradient(
                    circle at 50% 30%,
                    rgba(255,255,255,0.08),
                    transparent 45%
                ),
                #0c0c0c;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .about-logo {
            font-size: 75px;
            font-weight: 900;
            letter-spacing: -7px;
            color: #eeeeee;
        }

        /* =========================
           CTA
        ========================= */

        .cta {
            max-width: 1050px;
            margin: 80px auto 110px;
            padding: 80px 35px;
            border: 1px solid #242424;
            border-radius: 22px;
            text-align: center;
            background:
                radial-gradient(
                    circle at center,
                    rgba(255,255,255,0.07),
                    transparent 55%
                ),
                #0d0d0d;
        }

        .cta h2 {
            max-width: 700px;
            margin: auto;
            font-size: clamp(35px, 5vw, 58px);
            line-height: 1.05;
            letter-spacing: -3px;
        }

        .cta p {
            color: #808080;
            max-width: 550px;
            margin: 20px auto 30px;
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            border-top: 1px solid #1a1a1a;
            padding: 45px 25px;
        }

        .footer-container {
            max-width: 1100px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 30px;
        }

        .footer-logo {
            font-weight: 800;
            font-size: 20px;
        }

        .footer-copy {
            color: #666666;
            font-size: 13px;
        }

        .footer-links {
            display: flex;
            gap: 22px;
            font-size: 13px;
            color: #777777;
        }

        .footer-links a:hover {
            color: #ffffff;
        }

        /* =========================
           RESPONSIVO
        ========================= */

        @media (max-width: 800px) {

            .nav-links {
                display: none;
                position: absolute;
                top: 76px;
                left: 0;
                width: 100%;
                padding: 25px;
                background: #0a0a0a;
                border-bottom: 1px solid #1d1d1d;
                flex-direction: column;
                gap: 22px;
            }

            .nav-links.active {
                display: flex;
            }

            .menu-button {
                display: block;
            }

            .hero h1 {
                letter-spacing: -3px;
            }

            .stats {
                grid-template-columns: 1fr;
                margin-top: 0;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .about {
                grid-template-columns: 1fr;
                gap: 35px;
            }

            .about-box {
                min-height: 280px;
            }

            .footer-container {
                flex-direction: column;
                text-align: center;
            }
        }

        @media (max-width: 500px) {

            .navbar {
                padding: 0 18px;
            }

            .hero {
                padding-left: 18px;
                padding-right: 18px;
            }

            .hero h1 {
                font-size: 48px;
            }

            .hero p {
                font-size: 16px;
            }

            .section {
                padding-left: 18px;
                padding-right: 18px;
            }

            .cta {
                margin-left: 18px;
                margin-right: 18px;
                padding: 60px 22px;
            }

            .footer-links {
                flex-wrap: wrap;
                justify-content: center;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         MENU
    ========================= -->

    <header>
        <nav class="navbar">

            <a href="#" class="logo">
                Elements<span>.</span>
            </a>

            <button class="menu-button" onclick="toggleMenu()">
                ☰
            </button>

            <ul class="nav-links" id="navLinks">
                <li><a href="#inicio">Início</a></li>
                <li><a href="#comunidade">Comunidade</a></li>
                <li><a href="#sobre">Sobre nós</a></li>
                <li>
                    <a href="#entrar" class="nav-button">
                        Entrar na comunidade
                    </a>
                </li>
            </ul>

        </nav>
    </header>


    <!-- =========================
         HERO
    ========================= -->

    <main>

        <section class="hero" id="inicio">

            <div class="hero-content">

                <div class="badge">
                    <span class="badge-dot"></span>
                    Uma comunidade para quem constrói
                </div>

                <h1>
                    Pessoas certas.
                    <span>Novas oportunidades.</span>
                </h1>

                <p>
                    A Elements conecta empresários em um ambiente privado
                    para trocar ideias, compartilhar experiências,
                    criar conexões e descobrir novas oportunidades.
                </p>

                <div class="hero-buttons">
                    <a href="#entrar" class="button button-primary">
                        Conhecer a Elements →
                    </a>

                    <a href="#sobre" class="button button-secondary">
                        Saiba mais
                    </a>
                </div>

            </div>

        </section>


        <!-- =========================
             ESTATÍSTICAS
        ========================= -->

        <div class="stats">

            <div class="stat">
                <h3>100%</h3>
                <p>Ambiente focado em negócios</p>
            </div>

            <div class="stat">
                <h3>Privada</h3>
                <p>Comunidade exclusiva</p>
            </div>

            <div class="stat">
                <h3>24/7</h3>
                <p>Conexões e conversas</p>
            </div>

        </div>


        <!-- =========================
             COMUNIDADE
        ========================= -->

        <section class="section" id="comunidade">

            <div class="section-header">

                <div class="section-label">
                    A comunidade
                </div>

                <h2>
                    Mais do que um grupo.
                    Uma rede de conexões.
                </h2>

                <p>
                    A Elements foi criada para aproximar pessoas que
                    compartilham o mesmo interesse: construir, aprender
                    e crescer através de boas conexões.
                </p>

            </div>


            <div class="cards">

                <div class="card">

                    <div class="card-icon">
                        ↗
                    </div>

                    <h3>Networking</h3>

                    <p>
                        Conheça empresários, profissionais e pessoas
                        que estão construindo seus próprios projetos.
                    </p>

                </div>


                <div class="card">

                    <div class="card-icon">
                        ◇
                    </div>

                    <h3>Troca de experiências</h3>

                    <p>
                        Compartilhe ideias, desafios, estratégias e
                        aprendizados com outros membros da comunidade.
                    </p>

                </div>


                <div class="card">

                    <div class="card-icon">
                        +
                    </div>

                    <h3>Novas oportunidades</h3>

                    <p>
                        Uma conversa pode abrir portas para uma parceria,
                        projeto ou nova oportunidade.
                    </p>

                </div>

            </div>

        </section>


        <!-- =========================
             SOBRE NÓS
        ========================= -->

        <section class="section" id="sobre">

            <div class="about">

                <div class="about-text">

                    <div class="section-label">
                        Sobre nós
                    </div>

                    <h2>
                        Conexões que
                        fazem sentido.
                    </h2>

                    <p>
                        A Elements nasceu com uma ideia simples:
                        aproximar pessoas que estão construindo algo.
                    </p>

                    <p>
                        Criamos um espaço onde empresários podem
                        conversar, compartilhar conhecimento e conhecer
                        outras pessoas com diferentes experiências,
                        perspectivas e projetos.
                    </p>

                    <p>
                        Aqui, o objetivo não é apenas acumular contatos.
                        É criar relações que possam gerar valor de verdade.
                    </p>

                </div>


                <div class="about-box">

                    <div class="about-logo">
                        E.
                    </div>

                </div>

            </div>

        </section>


        <!-- =========================
             CTA
        ========================= -->

        <section class="cta" id="entrar">

            <h2>
                Seu próximo contato
                pode mudar seu próximo passo.
            </h2>

            <p>
                Faça parte da Elements e encontre uma comunidade
                feita para pessoas que querem trocar ideias,
                construir conexões e crescer.
            </p>

            <a href="#" class="button button-primary">
                Quero fazer parte →
            </a>

        </section>

    </main>


    <!-- =========================
         FOOTER
    ========================= -->

    <footer>

        <div class="footer-container">

            <div>
                <div class="footer-logo">
                    Elements.
                </div>

                <div class="footer-copy">
                    © 2026 Elements. Todos os direitos reservados.
                </div>
            </div>

            <div class="footer-links">
                <a href="#inicio">Início</a>
                <a href="#comunidade">Comunidade</a>
                <a href="#sobre">Sobre nós</a>
                <a href="#">Privacidade</a>
            </div>

        </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
    ========================= -->

    <script>

        function toggleMenu() {
            const menu = document.getElementById("navLinks");
            menu.classList.toggle("active");
        }

        document.querySelectorAll(".nav-links a").forEach(link => {

            link.addEventListener("click", () => {
                document.getElementById("navLinks")
                    .classList.remove("active");
            });

        });

    </script>

</body>
</html>
